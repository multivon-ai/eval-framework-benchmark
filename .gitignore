.env
__pycache__/
# Raw judge outputs: gitignore local re-runs, but keep the small
# ragtruth-sum files behind the headline result committed.
results/raw/**
!results/raw/*/
!results/raw/*/*_ragtruth-sum_run0.jsonl
data/halueval_qa_full.json
data/halueval_sum_full.json
.venv/
.venv-study/
.venv-analysis/
data/ragtruth_responses_full.jsonl
data/ragtruth_sources_full.jsonl
results/smoke/
.gstack/

# Rendered analysis outputs stay out of the public repo until the paper is public
study/analysis/figures/
study/analysis/out/
study/ANALYSIS.md

# ruflo / coverage litter — never commit auto-generated coverage-gap probes or OS cruft
test_coverage_gaps_*
test_coverage_gaps_*.py
*.DS_Store
.DS_Store
.ruflo/
.coverage
htmlcov/
.pytest_cache/
